{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"keysAndValues"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Sequence","preciseIdentifier":"s:ST"},{"kind":"text","text":"<("},{"kind":"typeIdentifier","text":"Key","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"kind":"text","text":")>, "},{"kind":"externalParam","text":"uniquingKeysWith"},{"kind":"text","text":" "},{"kind":"internalParam","text":"combine"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"keysAndValues","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of key-value pairs to use for the new"},{"type":"text","text":" "},{"type":"text","text":"dictionary."}]}]},{"name":"combine","content":[{"inlineContent":[{"text":"A closure that is called with the values for any duplicate","type":"text"},{"text":" ","type":"text"},{"text":"keys that are encountered. The closure returns the desired value for","type":"text"},{"text":" ","type":"text"},{"text":"the final dictionary.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You use this initializer to create a dictionary when you have a sequence"},{"type":"text","text":" "},{"type":"text","text":"of key-value tuples that might have duplicate keys. As the dictionary is"},{"type":"text","text":" "},{"type":"text","text":"built, the initializer calls the "},{"code":"combine","type":"codeVoice"},{"type":"text","text":" closure with the current and"},{"type":"text","text":" "},{"type":"text","text":"new values for any duplicate keys. Pass a closure as "},{"code":"combine","type":"codeVoice"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"returns the value to use in the resulting dictionary: The closure can"},{"type":"text","text":" "},{"type":"text","text":"choose between the two values, combine them to produce a new value, or"},{"type":"text","text":" "},{"type":"text","text":"even throw an error."}]},{"type":"codeListing","code":["let pairsWithDuplicateKeys = [(\"a\", 1), (\"b\", 2), (\"a\", 3), (\"b\", 4)]","","let firstValues = OrderedDictionary(","  pairsWithDuplicateKeys,","  uniquingKeysWith: { (first, _) in first })","\/\/ [\"a\": 1, \"b\": 2]","","let lastValues = OrderedDictionary(","  pairsWithDuplicateKeys,","  uniquingKeysWith: { (_, last) in last })","\/\/ [\"a\": 3, \"b\": 4]"],"syntax":null},{"type":"aside","name":"Complexity","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Expected O(","type":"text"},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"text":") on average, where ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"text":" is the count of","type":"text"},{"text":" ","type":"text"},{"text":"key-value pairs, if ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" implements high-quality hashing.","type":"text"}]}]}],"kind":"conten
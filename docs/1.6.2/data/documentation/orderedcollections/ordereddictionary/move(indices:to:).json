{"abstract":[{"type":"text","text":"Moves the pairs at the given indices so they land just before the pair at"},{"type":"text","text":" "},{"type":"text","text":"the given index, keeping them in the order the indices appear in"},{"type":"text","text":" "},{"type":"codeVoice","code":"indices"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/orderedcollections\/ordereddictionary\/move(indices:to:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/move(indices:to:)","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"move","kind":"identifier"},{"text":"(","kind":"text"},{"text":"indices","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Sequence","preciseIdentifier":"s:ST","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Index","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Index","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Indexa","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"destination","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Index","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Index","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Indexa","kind":"typeIdentifier"},{"text":")","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"indices","content":[{"inlineContent":[{"type":"text","text":"The indices of the pairs to move."}],"type":"paragraph"}]},{"name":"destination","content":[{"inlineContent":[{"type":"text","text":"The index before which to insert the moved pairs, in the"},{"type":"text","text":" "},{"type":"text","text":"original index space. Must be in the range "},{"type":"codeVoice","code":"0 ... count"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"destination"},{"type":"text","text":" is interpreted in the dictionary’s original index space"},{"type":"text","text":" "},{"type":"text","text":"(before the moved pairs are removed): the moved pairs are inserted just"},{"type":"text","text":" "},{"type":"text","text":"before the pair currently at "},{"type":"codeVoice","code":"destination"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":" to move them"},{"type":"text","text":" "},{"type":"text","text":"to the end."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"indices"},{"text":" must contain distinct, valid indices of the dictionary.","type":"text"}]},{"type":"codeListing","code":["var d: OrderedDictionary = [0: \"a\", 1: \"b\", 2: \"c\", 3: \"d\", 4: \"e\"]","d.move(indices: [4, 1], to: 0)","\/\/ d is now [4: \"e\", 1: \"b\", 0: \"a\", 2: \"c\", 3: \"d\"]"],"syntax":null},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"text":"O(","type":"text"},{"type":"codeVoice","code":"count"},{"text":") in the worst case. When the pairs form a","type":"text"},{"text":" ","type":"text"},{"text":"contiguous range or are moved a short distance, the operation is","type":"text"},{"text":" ","type":"text"},{"text":"proportional to the distance moved.","type":"text"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCod
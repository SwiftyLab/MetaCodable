{"kind":"symbol","metadata":{"roleHeading":"Instance Method","role":"symbol","title":"replaceElement(at:withKey:value:)","extendedModule":"OrderedCollections","symbolKind":"method","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Key","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"externalID":"s:18OrderedCollections0A10DictionaryV8ElementsV14replaceElement2at7withKey5valuex3key_q_AItSi_xq_tF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceElement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"withKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV3Keyxmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV5Valueq_mfp"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV7Elementa"}],"modules":[{"name":"OrderedCollections"}]},"abstract":[{"text":"Replaces the key-value pair at the specified index with a new pair,","type":"text"},{"text":" ","type":"text"},{"text":"returning the original element.","type":"text"}],"variants":[{"paths":["\/documentation\/orderedcollections\/ordereddictionary\/elements-swift.struct\/replaceelement(at:withkey:value:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceElement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":" "},{"kind":"internalParam","text":"index"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"withKey","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV3Keyxmfp"},{"text":", ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV5Valueq_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Elements-swift.struct\/Element","text":"Element","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV7Elementa","kind":"typeIdentifier"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The index of the element to replace. "},{"type":"codeVoice","code":"index"},{"type":"text","text":" must be a valid"},{"type":"text","text":" "},{"type":"text","text":"index of the dictionary."}]}],"name":"index"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The key of the new element. If the dictionary already contains","type":"text"},{"text":" ","type":"text"},{"text":"this key, it must be at ","type":"text"},{"type":"codeVoice","code":"index"},{"text":".","type":"text"}]}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The value of the new element."}]}],"name":"value"}]},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The original key-value pair that was replaced."}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The new key must either not already exist in the dictionary, or be","type":"text"},{"text":" ","type":"text"},{"text":"equal to the key currently stored at ","type":"text"},{"code":"index","type":"codeVoice"},{"text":". The latter form is","type":"text"},{"text":" ","type":"text"},{"text":"useful when equal keys can be distinguished by identity or some other","type":"text"},{"text":" ","type":"text"},{"text":"means — for example, replacing a decomposed Unicode string with its","type":"text"},{"text":" ","type":"text"},{"text":"precomposed equivalent:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"e\\u{301}\": 2, \"c\": 3","]","dict.elements.replaceElement(at: 1, withKey: \"é\", value: 2)","\/\/ dict is now [\"a\": 1, \"é\": 2, \"c\": 3]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the general case, the new key is appended, swapped into position, and"},{"text":" ","type":"text"},{"text":"the old key removed from the end, while the value is overwritten in","type":"text"},{"text":" ","type":"text"},{"text":"place — each step is O(1).","type":"text"},{"text":" ","type":"text"},{"text":"When the new key compares equal to the one being replaced, the pair","type":"text"},{"text":" ","type":"text"},{"text":"is updated in place and the hash table is left untouched.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"b\": 2, \"c\": 3","]","let old = dict.elements.replaceElement(at: 1, withKey: \"d\", value: 4)","\/\/ old == (key: \"b\", value: 2)","\/\/ dict is now [\"a\": 1, \"d\": 4, \"c\": 3]"]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"Expected amortized O(1), if "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" implements"},{"type":"text","text":" "},{"type":"text","text":"high-quality hashing."}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Elements-swift.struct\/replaceElement(at:withKey:value:)"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Elements-swift.struct"]]},"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary":{"url":"\/documentation\/orderedcollections\/ordereddictionary","navigatorTitle":[{"kind":"identifier","text":"OrderedDictionary"}],"role":"symbol","title":"OrderedDictionary","kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","abstract":[{"type":"text","text":"An ordered collection of key-value pairs."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedDictionary"}]},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections":{"abstract":[],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","type":"topic","title":"OrderedCollections","kind":"symbol","url":"\/documentation\/orderedcollections","role":"collection"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/Elements-swift.struct":{"abstract":[{"text":"A view of the contents of an ordered dictionary as a random-access","type":"
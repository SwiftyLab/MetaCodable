{"kind":"symbol","abstract":[{"text":"A syntax visitor that only visits the syntax nodes that are active","type":"text"},{"text":" ","type":"text"},{"text":"according to a particular build configuration.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxAnyVisitor\/init(viewMode:configuration:)","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxAnyVisitor\/init(viewMode:configuredRegions:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxAnyVisitor\/diagnostics"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxAnyVisitor\/visit(_:)"],"title":"Instance Methods"}],"metadata":{"role":"symbol","title":"ActiveSyntaxAnyVisitor","navigatorTitle":[{"text":"ActiveSyntaxAnyVisitor","kind":"identifier"}],"roleHeading":"Class","externalID":"s:13SwiftIfConfig22ActiveSyntaxAnyVisitorC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActiveSyntaxAnyVisitor","kind":"identifier"}],"modules":[{"name":"SwiftIfConfig"}],"symbolKind":"class"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiftifconfig\/activesyntaxanyvisitor"]}],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig"]]},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/SyntaxAnyVisitor"],"type":"inheritsFrom","title":"Inherits From"}],"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxAnyVisitor","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActiveSyntaxAnyVisitor"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"This subclass of "},{"code":"SyntaxVisitor","type":"codeVoice"},{"type":"text","text":" walks all of the syntax nodes in a given"},{"type":"text","text":" "},{"type":"text","text":"tree that are “active” according to a particular build configuration,"},{"type":"text","text":" "},{"type":"text","text":"meaning that the syntax would contribute to the resulting program when"},{"type":"text","text":" "},{"type":"text","text":"when compiled with that configuration. For example, given:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["#if DEBUG","  #if os(Linux)","   func f()","  #elseif os(iOS)","   func g()","  #endif","#endif"]},{"inlineContent":[{"type":"text","text":"And a build targeting Linux with the custom condition "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":" set, a"},{"type":"text","text":" "},{"type":"text","text":"complete walk via this visitor would visit "},{"type":"codeVoice","code":"func f"},{"type":"text","text":" but not "},{"type":"codeVoice","code":"func g"},{"type":"text","text":". If"},{"type":"text","text":" "},{"type":"text","text":"the build configuration instead targted macOS (but still had "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":" set),"},{"type":"text","text":" "},{"type":"text","text":"it would not visit either "},{"type":"codeVoice","code":"f"},{"type":"text","text":" or "},{"type":"codeVoice","code":"g"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All notes visited by this visitor will have the “active” state, i.e.,"},{"type":"text","text":" "},{"type":"codeVoice","code":"node.isActive(in: configuration)"},{"type":"text","text":" will have evaluated to "},{"type":"codeVoice","code":".active"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When errors occur, they will be recorded in the array of diagnostics."}],"type":"paragraph"}]}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/SwiftIfConfig/ActiveSyntaxAnyVisitor":{"url":"\/documentation\/swiftifconfig\/activesyntaxanyvisitor","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A syntax visitor that only visits the syntax nodes that are active","type":"text"},{"text":" ","type":"text"},{"text":"according to a particular build configuration.","type":"text"}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxAnyVisitor","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActiveSyntaxAnyVisitor"}],"navigatorTitle":[{"kind":"identifier","text":"ActiveSyntaxAnyVisitor"}],"title":"ActiveSyntaxAnyVisitor"},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/Syntax":{"role":"symbol","abstract":[{"text":"A Syntax node represents a tree of nodes with tokens at the leaves.","type":"text"},{"text":" ","type":"text"},{"text":"Each node has accessors for its known children, and allows efficient","type":"text"},{"text":" ","type":"text"},{"text":"iteration over the children through its ","type":"text"},{"type":"codeVoice","code":"children"},{"text":" property.","type":"text"}],"navigatorTitle":[{"text":"Syntax","kind":"identifier"}],"url":"\/documentation\/swiftsyntax\/syntax","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Syntax","kind":"identifier"}],"title":"Syntax","kind":"symbol","type":"topic","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/Syntax"},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/SyntaxAnyVisitor":{"url":"\/documentation\/swiftsyntax\/syntaxanyvisitor","navig
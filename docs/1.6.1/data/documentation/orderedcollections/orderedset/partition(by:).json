{"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedSet"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedSet\/partition(by:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/orderedcollections\/orderedset\/partition(by:)"]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"partition"},{"kind":"text","text":"("},{"kind":"externalParam","text":"by"},{"kind":"text","text":" "},{"kind":"internalParam","text":"belongsInSecondPartition"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:18OrderedCollections0A3SetV7Elementxmfp"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":") "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}]},{"kind":"parameters","parameters":[{"name":"belongsInSecondPartition","content":[{"inlineContent":[{"type":"text","text":"A predicate used to partition"},{"type":"text","text":" "},{"type":"text","text":"the collection. All elements satisfying this predicate are ordered"},{"type":"text","text":" "},{"type":"text","text":"after all elements not satisfying it."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The index of the first element in the reordered collection"},{"type":"text","text":" "},{"type":"text","text":"that matches "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":". If no elements in the"},{"type":"text","text":" "},{"type":"text","text":"collection match "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":", the returned index is"},{"type":"text","text":" "},{"type":"text","text":"equal to the collection’s "},{"type":"codeVoice","code":"endIndex"},{"type":"text","text":"."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"After partitioning a collection, there is a pivot index "},{"type":"codeVoice","code":"p"},{"type":"text","text":" where"},{"type":"text","text":" "},{"type":"text","text":"no element before "},{"type":"codeVoice","code":"p"},{"type":"text","text":" satisfies the "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":" "},{"type":"text","text":"predicate and every element at or after "},{"type":"codeVoice","code":"p"},{"type":"text","text":" satisfies"},{"type":"text","text":" "},{"type":"codeVoice","code":"belongsInSecondPartition"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In the following example, an ordered set of numbers is partitioned by a"},{"type":"text","text":" "},{"type":"text","text":"predicate that matches elements greater than 30."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["var numbers: OrderedSet = [30, 40, 20, 30, 30, 60, 10]","let p = numbers.partition(by: { $0 > 30 })","\/\/ p == 5","\/\/ numbers == [30, 10, 20, 30, 30, 60, 40]"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"numbers","type":"codeVoice"},{"text":" set is now arranged in two partitions. The first partition,","type":"text"},{"text":" ","type":"text"},{"code":"numbers[..<p]","type":"codeVoice"},{"text":", is made up of the elements that are not greater than 30.","type":"text"},{"text":" ","type":"text"},{"text":"The second partition, ","type":"text"},{"code":"numbers[p...]","type":"codeVoice"},{"text":", is made up of the elements that","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"are"}]},{"text":" greater than 30.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["let first = numbers[..<p]","\/\/ first == [30, 10, 20, 30, 30]","let second = numbers[p...]","\/\/ second == [60, 40]"]},{"style":"note","name":"Complexity","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"code":"count","type":"codeVoice"},{"type":"text","text":")"}]}]}]}],"abstract":[{"text":"Reorders the elements of the set such that all the elements that match the","type":"text"},{"text":" ","type":"text"},{"text":"given predicate are after all the elements that don’t match.","type":"text"}],"metadata":{"title":"partition(by:)","externalID":"s:18OrderedCollections0A3SetV9partition2bySiSbxKXE_tKF","roleHeading":"Instance Method","modules":[{"name":"OrderedCollections"}],"symbolKind":"method","extendedModule":"OrderedCollections","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Element","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"partition","kind":"identifier"},{"text":"(","kind":"text"},{"text":"by","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Element","preciseIdentifier":"s:18OrderedCollections0A3SetV7Elementxmfp","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIde
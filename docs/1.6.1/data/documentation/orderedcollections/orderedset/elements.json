{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedSet"]]},"variants":[{"paths":["\/documentation\/orderedcollections\/orderedset\/elements"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedSet\/elements","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"A view of the members of this set, as a regular array value.","type":"text"}],"metadata":{"role":"symbol","title":"elements","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"modules":[{"name":"OrderedCollections"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elements","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Element","preciseIdentifier":"s:18OrderedCollections0A3SetV7Elementxmfp","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"externalID":"s:18OrderedCollections0A3SetV8elementsSayxGvp","roleHeading":"Instance Property","extendedModule":"OrderedCollections","symbolKind":"property"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elements","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A3SetV7Elementxmfp"},{"text":"] { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"It is possible to mutate the set by updating the value of this property.","type":"text"},{"text":" ","type":"text"},{"text":"This guarantees that direct mutations happen in place when possible (i.e.,","type":"text"},{"text":" ","type":"text"},{"text":"without spurious copy-on-write copies).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"However, the set needs to ensure the uniqueness of its members, so every"},{"type":"text","text":" "},{"type":"text","text":"update to "},{"type":"codeVoice","code":"elements"},{"type":"text","text":" includes a postprocessing step to detect and remove"},{"type":"text","text":" "},{"type":"text","text":"duplicates over the entire array. This can be slower than doing the"},{"type":"text","text":" "},{"type":"text","text":"equivalent updates with direct "},{"type":"codeVoice","code":"OrderedSet"},{"type":"text","text":" operations, so updating"},{"type":"text","text":" "},{"type":"codeVoice","code":"elements"},{"type":"text","text":" is best used in cases where direct implementations aren’t"},{"type":"text","text":" "},{"type":"text","text":"available – for example, when you need to call a "},{"type":"codeVoice","code":"MutableCollection"},{"type":"text","text":" "},{"type":"text","text":"algorithm that isn’t directly implemented by "},{"type":"codeVoice","code":"OrderedSet"},{"type":"text","text":" itself."}]},{"type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O(1) for the getter. Mutating this property has an expected"},{"type":"text","text":" "},{"type":"text","text":"complexity of O("},{"type":"codeVoice","code":"count"},{"type":"text","text":"), if "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" implements high-quality hashing."}]}],"style":"note"}],"kind":"content"}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedSet/elements":{"url":"\/documentation\/orderedcollections\/orderedset\/elements","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A view of the members of this set, as a regular array value."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"elements","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Element","preciseIdentifier":"s:18OrderedCollections0A3SetV7Elementxmfp","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedSet\/elements","title":"elements","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]}},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections":{"role":"collection","abstract":[],"url":"\/documentation\/orderedcollections","title":"OrderedCollections","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","kind":"symbol","type":"topic"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedSet":{"abstract":[{"text":"An ordered collection of unique elements.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OrderedSet"}],"url":"\/documentation\/orderedcollections\/orderedset","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedSet"}],"title":"OrderedSet","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedSet"}}}
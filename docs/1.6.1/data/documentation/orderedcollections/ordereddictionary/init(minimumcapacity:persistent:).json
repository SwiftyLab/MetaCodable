n cancel","type":"text"},{"text":" ","type":"text"},{"text":"any capacity you’ve previously reserved by persistently reserving a","type":"text"},{"text":" ","type":"text"},{"text":"capacity of zero. (This also shrinks the hash table to the ideal size for","type":"text"},{"text":" ","type":"text"},{"text":"its current number elements.)","type":"text"}],"type":"paragraph"},{"style":"note","name":"Complexity","content":[{"inlineContent":[{"text":"O(","type":"text"},{"type":"codeVoice","code":"minimumCapacity"},{"text":")","type":"text"}],"type":"paragraph"}],"type":"aside"}],"kind":"content"}],"kind":"symbol","references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections":{"role":"collection","abstract":[],"url":"\/documentation\/orderedcollections","title":"OrderedCollections","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","kind":"symbol","type":"topic"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","abstract":[{"type":"text","text":"An ordered collection of key-value pairs."}],"title":"OrderedDictionary","navigatorTitle":[{"text":"OrderedDictionary","kind":"identifier"}],"url":"\/documentation\/orderedcollections\/ordereddictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedDictionary","kind":"identifier"}],"type":"topic"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/init(minimumCapacity:persistent:)":{"role":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/init(minimumCapacity:persistent:)","abstract":[{"type":"text","text":"Creates an empty dictionary with preallocated space for at least the"},{"type":"text","text":" "},{"type":"text","text":"specified number of elements."}],"type":"top
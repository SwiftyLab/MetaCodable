":"paragraph","inlineContent":[{"type":"text","text":"In optimized builds, this initializer does not verify that the keys are"},{"type":"text","text":" "},{"type":"text","text":"actually unique. This makes creating the dictionary somewhat faster if you"},{"type":"text","text":" "},{"type":"text","text":"know for sure that the elements are unique (e.g., because they come from"},{"type":"text","text":" "},{"type":"text","text":"another collection with guaranteed-unique members, such as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Dictionary"},{"type":"text","text":"). However, if you accidentally call this initializer with"},{"type":"text","text":" "},{"type":"text","text":"duplicate members, it can return a corrupt dictionary value that may be"},{"type":"text","text":" "},{"type":"text","text":"difficult to debug."}]},{"type":"aside","style":"note","name":"Precondition","content":[{"type":"paragraph","inlineContent":[{"text":"The sequence must not have duplicate keys.","type":"text"}]}]},{"type":"aside","style":"note","name":"Complexity","content":[{"inlineContent":[{"type":"text","text":"Expected O("},{"type":"emphasis","inlineContent":[{"text":"n","type":"text"}]},{"type":"text","text":") on average, where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the count if"},{"type":"text","text":" "},{"type":"text","text":"key-value pairs, if "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" implements high-quality hashing."}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/orderedcollections\/ordereddictionary\/init(uncheckeduniquekeyswithvalues:)-6gxhj"]}],"metadata":{"symbolKind":"init","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"uncheckedUniqueKeysWithValues","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text
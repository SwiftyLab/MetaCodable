{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceElement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":" "},{"kind":"internalParam","text":"index"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"withKey","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp"},{"text":", ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"text":") -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Element","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV7Elementa"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The index of the element to replace. ","type":"text"},{"code":"index","type":"codeVoice"},{"text":" must be a valid","type":"text"},{"text":" ","type":"text"},{"text":"index of the dictionary.","type":"text"}]}],"name":"index"},{"content":[{"inlineContent":[{"type":"text","text":"The key of the new element. If the dictionary already contains"},{"type":"text","text":" "},{"type":"text","text":"this key, it must be at "},{"type":"codeVoice","code":"index"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"key"},{"content":[{"inlineContent":[{"type":"text","text":"The value of the new element."}],"type":"paragraph"}],"name":"value"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The original key-value pair that was replaced."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The new key must either not already exist in the dictionary, or be","type":"text"},{"text":" ","type":"text"},{"text":"equal to the key currently stored at ","type":"text"},{"code":"index","type":"codeVoice"},{"text":". The latter form is","type":"text"},{"text":" ","type":"text"},{"text":"useful when equal keys can be distinguished by identity or some other","type":"text"},{"text":" ","type":"text"},{"text":"means — for example, replacing a decomposed Unicode string with its","type":"text"},{"text":" ","type":"text"},{"text":"precomposed equivalent:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"e\\u{301}\": 2, \"c\": 3","]","dict.replaceElement(at: 1, withKey: \"é\", value: 2)","\/\/ dict is now [\"a\": 1, \"é\": 2, \"c\": 3]"],"type":"codeListing"},{"inlineContent":[{"text":"In the general case, the new pair is appended, swapped into position,","type":"text"},{"text":" ","type":"text"},{"text":"and the old element is removed from the end — each step is O(1).","type":"text"},{"text":" ","type":"text"},{"text":"When the new key compares equal to the one being replaced, the pair","type":"text"},{"text":" ","type":"text"},{"text":"is updated in place and the hash table is left untouched.","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"b\": 2, \"c\": 3","]","let old = dict.replaceElement(at: 1, withKey: \"d\", value: 4)","\/\/ old == (key: \"b\", value: 2)","\/\/ dict is now [\"a\": 1, \"d\": 4, \"c\": 3]"],"type":"codeListing"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Expected amortized O(1), if "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" implements"},{"type":"text","text":" "},{"type":"text","text":"high-quality hashing."}],"type":"paragraph"}],"type":"aside","name":"Complexity"}]}],"abstract":[{"text":"Replaces the key-value pair at the specified index with a new pair,","type":"text"},{"text":" ","type":"text"},{"text":"returning the original element.","type":"text"}],"metadata":{"modules":[{"name":"OrderedCollections"}],"roleHeading":"Instance Method","externalID":"s:18OrderedCollections0A10DictionaryV14replaceElement2at7withKey5valuex3key_q_AGtSi_xq_tF","title":"replaceElement(at:withKey:value:)","extendedModule":"OrderedCollections","role":"symbol","symbolKind":"method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Key","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Hashable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceElement","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"withKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp"},{"text":", ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"text":") -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV7Elementa"}]},"hierarc
"Aquamarine\"","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is removed from the dictionary by assigning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to the key-based"},{"type":"text","text":" "},{"type":"text","text":"subscript."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["hues[\"Aquamarine\"] = nil","print(hues)","\/\/ Prints \"[\"Coral\": 18, \"Heliotrope\": 296, \"Cerise\": 330]\""]},{"style":"note","type":"aside","name":"Complexity","content":[{"inlineContent":[{"text":"Looking up values in the dictionary through this subscript","type":"text"},{"text":" ","type":"text"},{"text":"has an expected complexity of O(1) hashing\/comparison operations on","type":"text"},{"text":" ","type":"text"},{"text":"average, if ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" implements high-quality hashing. Updating the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary also has an amortized expected complexity of O(1) –","type":"text"},{"text":" ","type":"text"},{"text":"although individual updates may need to copy or resize the dictionary’s","type":"text"},{"text":" ","type":"text"},{"text":"underlying storage.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:)"]}],"metadata":{"title":"subscript(_:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"text":"subscrip
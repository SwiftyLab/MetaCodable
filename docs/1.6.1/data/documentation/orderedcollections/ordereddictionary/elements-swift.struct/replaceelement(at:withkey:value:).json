s":[{"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceElement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":" "},{"kind":"internalParam","text":"index"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"withKey"},{"kind":"text","text":" "},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Key","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV3Keyxmfp"},{"kind":"text","text":", "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV5Valueq_mfp"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Elements-swift.struct\/Element","kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV8ElementsV7Elementa"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The index of the element to replace. ","type":"text"},{"type":"codeVoice","code":"index"},{"text":" must be a valid","type":"text"},{"text":" ","type":"text"},{"text":"index of the dictionary.","type":"text"}]}],"name":"index"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The key of the new element. If the dictionary already contains","type":"text"},{"text":" ","type":"text"},{"text":"this key, it must be at ","type":"text"},{"type":"codeVoice","code":"index"},{"text":".","type":"text"}]}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The value of the new element.","type":"text"}]}],"name":"value"}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The original key-value pair that was replaced."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The new key must either not already exist in the dictionary, or be"},{"type":"text","text":" "},{"type":"text","text":"equal to the key currently stored at "},{"code":"index","type":"codeVoice"},{"type":"text","text":". The latter form is"},{"type":"text","text":" "},{"type":"text","text":"useful when equal keys can be distinguished by identity or some other"},{"type":"text","text":" "},{"type":"text","text":"means — for example, replacing a decomposed Unicode string with its"},{"type":"text","text":" "},{"type":"text","text":"precomposed equivalent:"}],"type":"paragraph"},{"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"e\\u{301}\": 2, \"c\": 3","]","dict.elements.replaceElement(at: 1, withKey: \"é\", value: 2)","\/\/ dict is now [\"a\": 1, \"é\": 2, \"c\": 3]"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"In the general case, the new pair is appended, swapped into position,","type":"text"},{"text":" ","type":"text"},{"text":"and the old element is removed from the end — each step is O(1).","type":"text"},{"text":" ","type":"text"},{"text":"When the new key compares equal to the one being replaced, the pair","type":"text"},{"text":" ","type":"text"},{"text":"is updated in place and the hash table is left untouched.","type":"text"}],"type":"paragraph"},{"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"b\": 2, \"c\": 3","]","let old = dict.elements.replaceElement(at: 1, withKey: \"d\", value: 4)","\/\/ old == (key: \"b\", value: 2)","\/\/ dict is now [\"a\": 1, \"d\": 4, \"c\": 3]"],"type":"codeListing","syntax":null},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Expected amortized O(1), if ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" implements","type":"text"},{"text":" ","type":"text"},{"text":"high-quality hashing.","type":"text"}]}],"name":"Complexity"}]}],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Elements-swift.struct"]]},"abstract":[{"type":"text","text":"Replaces the key-value pair at the specified index with a new pair,"},{"type":"text","text":" "},{"type":"text","text":"returning the original element."}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","abstract":[{"type":"text","text":"An ordered collection of key-value pairs."}],"title":"OrderedDictionary","navigatorTitle":[{"text":"OrderedDictionary","kind":"identifier"}],"url":"\/documentation\/orderedcollections\/ordereddictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedDictionary","kind":"identifier"}],"type":"topic"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/Elements-swift.struct/Element":{"type":"topic","title":"OrderedDictionary.Elements.Element","kind":"symbol","abstract":[{"text":"The element type of the collection.","type":"text"}],"url":"\/documentation\/orderedcollections\/ordereddictionary\/elements-swift.struct\/element","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Elements-swift.struct\/Element","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":
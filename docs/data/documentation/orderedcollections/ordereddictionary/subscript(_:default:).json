{"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/subscript(_:default:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:default:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","metadata":{"externalID":"s:18OrderedCollections0A10DictionaryV_7defaultq_x_q_yXKtcip","role":"symbol","title":"subscript(_:default:)","symbolKind":"subscript","extendedModule":"OrderedCollections","fragments":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","text":"Key"},{"kind":"text","text":", "},{"kind":"externalParam","text":"default"},{"kind":"text","text":" _: "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]},"roleHeading":"Instance Subscript","modules":[{"name":"OrderedCollections"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary"]]},"abstract":[{"text":"Accesses the value with the given key. If the dictionary doesn’t contain","type":"text"},{"text":" ","type":"text"},{"text":"the given key, accesses the provided default value as if the key and","type":"text"},{"text":" ","type":"text"},{"text":"default value existed in the dictionary.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Key","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"default","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"defaultValue","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"@autoclosure","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"key","content":[{"type":"paragraph","inlineContent":[{"text":"The key the look up in the dictionary.","type":"text"}]}]},{"name":"defaultValue","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The default value to use if "},{"code":"key","type":"codeVoice"},{"type":"text","text":" doesn’t exist in the"},{"type":"text","text":" "},{"type":"text","text":"dictionary."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"text":"The value associated with ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" in the dictionary; otherwise,","type":"text"},{"text":" ","type":"text"},{"code":"defaultValue","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"Use this subscript when you want either the value for a particular key","type":"text"},{"text":" ","type":"text"},{"text":"or, when that key is not present in the dictionary, a default value. This","type":"text"},{"text":" ","type":"text"},{"text":"example uses the subscript with a message to use in case an HTTP response","type":"text"},{"text":" ","type":"text"},{"text":"code isn’t recognized:","type":"text"}],"type":"paragraph"},{"code":["var responseMessages: OrderedDictionary = [","    200: \"OK\",","    403: \"Access forbidden\",","    404: \"File not found\",","    500: \"Internal server error\"]","","let httpResponseCodes = [200, 403, 301]","for code in httpResponseCodes {","    let message = responseMessages[code, default: \"Unknown response\"]","    print(\"Response \\(code): \\(message)\")","}","\/\/ Prints \"Response 200: OK\"","\/\/ Prints \"Response 403: Access forbidden\"","\/\/ Prints \"Response 301: Unknown response\""],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"When a dictionary’s ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":" type has value semantics, you can use this","type":"text"},{"text":" ","type":"text"},{"text":"subscript to perform in-place operations on values in the dictionary.","type":"text"},{"text":" ","type":"text"},{"text":"The following example uses this subscript while counting the occurrences","type":"text"},{"text":" ","type":"text"},{"text":"of each letter in a string:","type":"text"}],"type":"paragraph"},{"code":["let message = \"Hello, Elle!\"","var letterCounts: OrderedDictionary<Character, Int> = [:]","for letter in message {","    letterCounts[letter, default: 0] += 1","}","\/\/ letterCounts == [\"H\": 1, \"e\": 2, \"l\": 4, \"o\": 1, ...]"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"When "},{"code":"letterCounts[letter, defaultValue: 0] += 1","type":"codeVoice"},{"type":"text","text":" is executed with a"},{"type":"text","text":" "},{"type":"text","text":"value of "},{"code":"letter","type":"codeVoice"},{"type":"text","text":" that isn’t already a key in "},{"code":"letterCounts","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"specified default value ("},{"code":"0","type":"codeVoice"},{"type":"text","text":") is returned from the subscript,"},{"type":"text","text":" "},{"type":"text","text":"incremented, and then added to the dictionary under that key."}],"type":"paragraph"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"Do not use this subscript to modify dictionary values if the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary’s ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":" type is a class. In that case, the default value","type":"text"},{"text":" ","type":"text"},{"text":"and key are not written back to the dictionary after an operation. (For","type":"text"},{"text":" ","type":"text"},{"text":"a variant of this operation that supports this usecase, see","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"updateValue(forKey:default:_:)"},{"text":".)","type":"text"}],"type":"paragraph"}]},{"name":"Complexity","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Looking up values in the dictionary through this subscript","type":"text"},{"text":" ","type":"text"},{"text":"has an expected complexity of O(1) hashing\/comparison operations on","type":"text"},{"text":" ","type":"text"},{"text":"average, if ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" implements high-quality hashing. Updating the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary also has an amortized expected complexity of O(1) –","type":"text"},{"text":" ","type":"text"},{"text":"although individual updates may need to copy or resize the dictionary’s","type":"text"},{"text":" ","type":"text"},{"text":"underlying storage.","type":"text"}]}]}]}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","abstract":[{"type":"text","text":"An ordered collection of key-value pairs."}],"title":"OrderedDictionary","navigatorTitle":[{"text":"OrderedDictionary","kind":"identifier"}],"url":"\/documentation\/orderedcollections\/ordereddictionary","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OrderedDictionary","kind":"identifier"}],"type":"topic"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/subscript(_:default:)":{"role":"symbol","kind":"symbol","type":"topic","title":"subscript(_:default:)","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"default","kind":"externalParam"},{"text":" _: ","kind":"text"},{"text":"@autoclosure","kind":"attribute"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value","kind":"typeIdentifier"}],"url":"\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:default:)","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Key"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"abstract":[{"type":"text","text":"Accesses the value with the given key. If the dictionary doesn’t contain"},{"type":"text","text":" "},{"type":"text","text":"the given key, accesses the provided default value as if the key and"},{"type":"text","text":" "},{"type":"text","text":"default value existed in the dictionary."}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/subscript(_:default:)"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections":{"role":"collection","abstract":[],"url":"\/documentation\/orderedcollections","title":"OrderedCollections","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","kind":"symbol","type":"topic"}}}
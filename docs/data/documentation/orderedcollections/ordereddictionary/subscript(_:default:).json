{"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/subscript(_:default:)","interfaceLanguage":"swift"},"sections":[],"metadata":{"title":"subscript(_:default:)","conformance":{"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"roleHeading":"Instance Subscript","externalID":"s:18OrderedCollections0A10DictionaryV_7defaultq_x_q_yXKtcip","role":"symbol","modules":[{"name":"OrderedCollections"}],"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"default","kind":"externalParam"},{"text":" _: ","kind":"text"},{"text":"@autoclosure","kind":"attribute"},{"text":" () -> ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value","kind":"typeIdentifier"}],"extendedModule":"OrderedCollections","symbolKind":"subscript"},"abstract":[{"type":"text","text":"Accesses the value with the given key. If the dictionary doesn’t contain"},{"type":"text","text":" "},{"type":"text","text":"the given key, accesses the provided default value as if the key and"},{"type":"text","text":" "},{"type":"text","text":"default value existed in the dictionary."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"subscript"},{"kind":"text","text":"("},{"kind":"internalParam","text":"key"},{"kind":"text","text":": "},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"externalParam","text":"default"},{"kind":"text","text":" "},{"kind":"internalParam","text":"defaultValue"},{"kind":"text","text":": "},{"kind":"attribute","text":"@autoclosure"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The key the look up in the dictionary."}],"type":"paragraph"}],"name":"key"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The default value to use if ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" doesn’t exist in the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary.","type":"text"}]}],"name":"defaultValue"}]},{"content":[{"type":"heading","anchor":"return-value","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"text":"The value associated with ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" in the dictionary; otherwise,","type":"text"},{"text":" ","type":"text"},{"code":"defaultValue","type":"codeVoice"},{"text":".","type":"text"}]}],"kind":"content"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use this subscript when you want either the value for a particular key"},{"type":"text","text":" "},{"type":"text","text":"or, when that key is not present in the dictionary, a default value. This"},{"type":"text","text":" "},{"type":"text","text":"example uses the subscript with a message to use in case an HTTP response"},{"type":"text","text":" "},{"type":"text","text":"code isn’t recognized:"}],"type":"paragraph"},{"code":["var responseMessages: OrderedDictionary = [","    200: \"OK\",","    403: \"Access forbidden\",","    404: \"File not found\",","    500: \"Internal server error\"]","","let httpResponseCodes = [200, 403, 301]","for code in httpResponseCodes {","    let message = responseMessages[code, default: \"Unknown response\"]","    print(\"Response \\(code): \\(message)\")","}","\/\/ Prints \"Response 200: OK\"","\/\/ Prints \"Response 403: Access forbidden\"","\/\/ Prints \"Response 301: Unknown response\""],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"When a dictionary’s ","type":"text"},{"type":"codeVoice","code":"Value"},{"text":" type has value semantics, you can use this","type":"text"},{"text":" ","type":"text"},{"text":"subscript to perform in-place operations on values in the dictionary.","type":"text"},{"text":" ","type":"text"},{"text":"The following example uses this subscript while counting the occurrences","type":"text"},{"text":" ","type":"text"},{"text":"of each letter in a string:","type":"text"}],"type":"paragraph"},{"code":["let message = \"Hello, Elle!\"","var letterCounts: OrderedDictionary<Character, Int> = [:]","for letter in message {","    letterCounts[letter, default: 0] += 1","}","\/\/ letterCounts == [\"H\": 1, \"e\": 2, \"l\": 4, \"o\": 1, ...]"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"When "},{"code":"letterCounts[letter, defaultValue: 0] += 1","type":"codeVoice"},{"type":"text","text":" is executed with a"},{"type":"text","text":" "},{"type":"text","text":"value of "},{"code":"letter","type":"codeVoice"},{"type":"text","text":" that isn’t already a key in "},{"code":"letterCounts","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"specified default value ("},{"code":"0","type":"codeVoice"},{"type":"text","text":") is returned from the subscript,"},{"type":"text","text":" "},{"type":"text","text":"incremented, and then added to the dictionary under that key."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Do not use this subscript to modify dictionary values if the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary’s ","type":"text"},{"code":"Value","type":"codeVoice"},{"text":" type is a class. In that case, the default value","type":"text"},{"text":" ","type":"text"},{"text":"and key are not written back to the dictionary after an operation. (For","type":"text"},{"text":" ","type":"text"},{"text":"a variant of this operation that supports this usecase, see","type":"text"},{"text":" ","type":"text"},{"code":"updateValue(forKey:default:_:)","type":"codeVoice"},{"text":".)","type":"text"}]}],"name":"Note","type":"aside","style":"note"},{"content":[{"inlineContent":[{"text":"Looking up values in the dictionary through this subscript","type":"text"},{"text":" ","type":"text"},{"text":"has an expected complexity of O(1) hashing\/comparison operations on","type":"text"},{"text":" ","type":"text"},{"text":"average, if ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" implements high-quality hashing. Updating the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary also has an amortized expected complexity of O(1) –","type":"text"},{"text":" ","type":"text"},{"text":"although individual updates may need to copy or resize the dictionary’s","type":"text"},{"text":" ","type":"text"},{"text":"underlying storage.","type":"text"}],"type":"paragraph"}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:default:)"]}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary":{"url":"\/documentation\/orderedcollections\/ordereddictionary","navigatorTitle":[{"kind":"identifier","text":"OrderedDictionary"}],"role":"symbol","title":"OrderedDictionary","kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","abstract":[{"type":"text","text":"An ordered collection of key-value pairs."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedDictionary"}]},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/subscript(_:default:)":{"url":"\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:default:)","role":"symbol","abstract":[{"type":"text","text":"Accesses the value with the given key. If the dictionary doesn’t contain"},{"type":"text","text":" "},{"type":"text","text":"the given key, accesses the provided default value as if the key and"},{"type":"text","text":" "},{"type":"text","text":"default value existed in the dictionary."}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/subscript(_:default:)","kind":"symbol","title":"subscript(_:default:)","type":"topic","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Key","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"default","kind":"externalParam"},{"text":" _: ","kind":"text"},{"text":"@autoclosure","kind":"attribute"},{"text":" () -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier"}]},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections":{"abstract":[],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","type":"topic","title":"OrderedCollections","kind":"symbol","url":"\/documentation\/orderedcollections","role":"collection"}}}
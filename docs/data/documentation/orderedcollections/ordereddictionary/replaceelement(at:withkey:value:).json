{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary"]]},"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/replaceElement(at:withKey:value:)","interfaceLanguage":"swift"},"metadata":{"symbolKind":"method","externalID":"s:18OrderedCollections0A10DictionaryV14replaceElement2at7withKey5valuex3key_q_AGtSi_xq_tF","extendedModule":"OrderedCollections","title":"replaceElement(at:withKey:value:)","roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"replaceElement"},{"kind":"text","text":"("},{"kind":"externalParam","text":"at"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"withKey"},{"kind":"text","text":": "},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","kind":"typeIdentifier","text":"Key"},{"kind":"text","text":", "},{"kind":"externalParam","text":"value"},{"kind":"text","text":": "},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV7Elementa","kind":"typeIdentifier","text":"Element"}],"modules":[{"name":"OrderedCollections"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}]}},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceElement","kind":"identifier"},{"text":"(","kind":"text"},{"text":"at","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"index","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"withKey","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","text":"Key","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"value","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV7Elementa","text":"Element","kind":"typeIdentifier","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Element"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"inlineContent":[{"text":"The index of the element to replace. ","type":"text"},{"type":"codeVoice","code":"index"},{"text":" must be a valid","type":"text"},{"text":" ","type":"text"},{"text":"index of the dictionary.","type":"text"}],"type":"paragraph"}],"name":"index"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The key of the new element. If the dictionary already contains","type":"text"},{"text":" ","type":"text"},{"text":"this key, it must be at ","type":"text"},{"code":"index","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"key"},{"content":[{"inlineContent":[{"type":"text","text":"The value of the new element."}],"type":"paragraph"}],"name":"value"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"The original key-value pair that was replaced."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The new key must either not already exist in the dictionary, or be"},{"type":"text","text":" "},{"type":"text","text":"equal to the key currently stored at "},{"type":"codeVoice","code":"index"},{"type":"text","text":". The latter form is"},{"type":"text","text":" "},{"type":"text","text":"useful when equal keys can be distinguished by identity or some other"},{"type":"text","text":" "},{"type":"text","text":"means — for example, replacing a decomposed Unicode string with its"},{"type":"text","text":" "},{"type":"text","text":"precomposed equivalent:"}],"type":"paragraph"},{"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"e\\u{301}\": 2, \"c\": 3","]","dict.replaceElement(at: 1, withKey: \"é\", value: 2)","\/\/ dict is now [\"a\": 1, \"é\": 2, \"c\": 3]"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"In the general case, the new key is appended, swapped into position, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the old key removed from the end, while the value is overwritten in"},{"type":"text","text":" "},{"type":"text","text":"place — each step is O(1)."},{"type":"text","text":" "},{"type":"text","text":"When the new key compares equal to the one being replaced, the pair"},{"type":"text","text":" "},{"type":"text","text":"is updated in place and the hash table is left untouched."}],"type":"paragraph"},{"code":["var dict: OrderedDictionary = [","    \"a\": 1, \"b\": 2, \"c\": 3","]","let old = dict.replaceElement(at: 1, withKey: \"d\", value: 4)","\/\/ old == (key: \"b\", value: 2)","\/\/ dict is now [\"a\": 1, \"d\": 4, \"c\": 3]"],"syntax":null,"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expected amortized O(1), if "},{"code":"Key","type":"codeVoice"},{"type":"text","text":" implements"},{"type":"text","text":" "},{"type":"text","text":"high-quality hashing."}]}],"style":"note","type":"aside","name":"Complexity"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/orderedcollections\/ordereddictionary\/replaceelement(at:withkey:value:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Replaces the key-value pair at the specified index with a new pair,"},{"type":"text","text":" "},{"type":"text","text":"returning the original element."}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/Element":{"url":"\/documentation\/orderedcollections\/ordereddictionary\/element","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"navigatorTitle":[{"kind":"identifier","text":"Element"}],"type":"topic","abstract":[{"type":"text","text":"The element type of a dictionary: a tuple containing an individual"},{"type":"text","text":" "},{"type":"text","text":"key-value pair."}],"kind":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Key","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}]},"role":"symbol","title":"OrderedDictionary.Element","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/Element"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/replaceElement(at:withKey:value:)":{"type":"topic","url":"\/documentation\/orderedcollections\/ordereddictionary\/replaceelement(at:withkey:value:)","abstract":[{"type":"text","text":"Replaces the key-value pair at the specified index with a new pair,"},{"type":"text","text":" "}
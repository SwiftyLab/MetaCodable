{"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/subscript(_:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:18OrderedCollections0A10DictionaryVyq_Sgxcip","title":"subscript(_:)","extendedModule":"OrderedCollections","symbolKind":"subscript","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"roleHeading":"Instance Subscript","modules":[{"name":"OrderedCollections"}],"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","text":"Key","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","text":"Value","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary"]]},"abstract":[{"text":"Accesses the value associated with the given key for reading and writing.","type":"text"}],"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"key","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Key","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp"},{"text":") -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp"},{"text":"? { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The key to find in the dictionary.","type":"text"}]}],"name":"key"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"text":"The value associated with ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" if ","type":"text"},{"code":"key","type":"codeVoice"},{"text":" is in the dictionary;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise, ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This "},{"type":"emphasis","inlineContent":[{"type":"text","text":"key-based"}]},{"type":"text","text":" subscript returns the value for the given key if the key"},{"type":"text","text":" "},{"type":"text","text":"is found in the dictionary, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the key is not found."}]},{"type":"paragraph","inlineContent":[{"text":"The following example creates a new dictionary and prints the value of a","type":"text"},{"text":" ","type":"text"},{"text":"key found in the dictionary (","type":"text"},{"type":"codeVoice","code":"\"Coral\""},{"text":") and a key not found in the","type":"text"},{"text":" ","type":"text"},{"text":"dictionary (","type":"text"},{"type":"codeVoice","code":"\"Cerise\""},{"text":").","type":"text"}]},{"syntax":null,"type":"codeListing","code":["var hues: OrderedDictionary = [\"Heliotrope\": 296, \"Coral\": 16, \"Aquamarine\": 156]","print(hues[\"Coral\"])","\/\/ Prints \"Optional(16)\"","print(hues[\"Cerise\"])","\/\/ Prints \"nil\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you assign a value for a key and that key already exists, the"},{"type":"text","text":" "},{"type":"text","text":"dictionary overwrites the existing value. If the dictionary doesn’t"},{"type":"text","text":" "},{"type":"text","text":"contain the key, the key and value are added as a new key-value pair."}]},{"type":"paragraph","inlineContent":[{"text":"Here, the value for the key ","type":"text"},{"code":"\"Coral\"","type":"codeVoice"},{"text":" is updated from ","type":"text"},{"code":"16","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"18","type":"codeVoice"},{"text":" and a","type":"text"},{"text":" ","type":"text"},{"text":"new key-value pair is added for the key ","type":"text"},{"code":"\"Cerise\"","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":null,"type":"codeListing","code":["hues[\"Coral\"] = 18","print(hues[\"Coral\"])","\/\/ Prints \"Optional(18)\"","","hues[\"Cerise\"] = 330","print(hues[\"Cerise\"])","\/\/ Prints \"Optional(330)\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you assign "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" as the value for the given key, the dictionary"},{"type":"text","text":" "},{"type":"text","text":"removes that key and its associated value."}]},{"type":"paragraph","inlineContent":[{"text":"In the following example, the key-value pair for the key ","type":"text"},{"code":"\"Aquamarine\"","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is removed from the dictionary by assigning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to the key-based","type":"text"},{"text":" ","type":"text"},{"text":"subscript.","type":"text"}]},{"syntax":null,"type":"codeListing","code":["hues[\"Aquamarine\"] = nil","print(hues)","\/\/ Prints \"[\"Coral\": 18, \"Heliotrope\": 296, \"Cerise\": 330]\""]},{"style":"note","type":"aside","name":"Complexity","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Looking up values in the dictionary through this subscript"},{"type":"text","text":" "},{"type":"text","text":"has an expected complexity of O(1) hashing\/comparison operations on"},{"type":"text","text":" "},{"type":"text","text":"average, if "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" implements high-quality hashing. Updating the"},{"type":"text","text":" "},{"type":"text","text":"dictionary also has an amortized expected complexity of O(1) –"},{"type":"text","text":" "},{"type":"text","text":"although individual updates may need to copy or resize the dictionary’s"},{"type":"text","text":" "},{"type":"text","text":"underlying storage."}]}]}],"kind":"content"}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary/subscript(_:)":{"url":"\/documentation\/orderedcollections\/ordereddictionary\/subscript(_:)","kind":"symbol","title":"subscript(_:)","role":"symbol","fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"Key","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV3Keyxmfp","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Value","preciseIdentifier":"s:18OrderedCollections0A10DictionaryV5Valueq_mfp","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary\/subscript(_:)","conformance":{"constraints":[{"code":"Key","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Hashable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"type":"topic","abstract":[{"type":"text","text":"Accesses the value associated with the given key for reading and writing."}]},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections":{"abstract":[],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections","type":"topic","title":"OrderedCollections","kind":"symbol","url":"\/documentation\/orderedcollections","role":"collection"},"doc://com.SwiftyLab.HelperCoders/documentation/OrderedCollections/OrderedDictionary":{"url":"\/documentation\/orderedcollections\/ordereddictionary","navigatorTitle":[{"kind":"identifier","text":"OrderedDictionary"}],"role":"symbol","title":"OrderedDictionary","kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/OrderedCollections\/OrderedDictionary","abstract":[{"type":"text","text":"An ordered collection of key-value pairs."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OrderedDictionary"}]}}}
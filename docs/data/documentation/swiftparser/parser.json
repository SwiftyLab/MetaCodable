{"sections":[],"variants":[{"paths":["\/documentation\/swiftparser\/parser"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"SwiftParser"}],"navigatorTitle":[{"kind":"identifier","text":"Parser"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Parser","kind":"identifier"}],"title":"Parser","symbolKind":"struct","role":"symbol","externalID":"s:11SwiftParser0B0V"},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/init(_:maximumNestingLevel:parseTransition:swiftVersion:)-57azo","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/init(_:maximumNestingLevel:parseTransition:swiftVersion:)-69wxh"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/lookaheadRanges"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/defaultSwiftVersion"],"generated":true},{"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/parse(source:)","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/parse(source:maximumNestingLevel:swiftVersion:)","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/parseIncrementally(source:maximumNestingLevel:parseTransition:)-30y1m","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/parseIncrementally(source:maximumNestingLevel:parseTransition:)-8hjcw","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/parseIncrementally(source:parseTransition:)-2gtt2","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/parseIncrementally(source:parseTransition:)-dj0z"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser\/SwiftVersion"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser"]]},"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"A parser for the Swift programming language."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Parser","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/Parser","type":"reference"},{"type":"text","text":" implements a recursive descent parser that produces a SwiftSyntax"},{"type":"text","text":" "},{"type":"text","text":"tree. Its implementation is divided among a set of files named for the"},{"type":"text","text":" "},{"type":"text","text":"class of syntax nodes they parse. For example, declaration parsing happens"},{"type":"text","text":" "},{"type":"text","text":"in "},{"code":"Declaration.swift","type":"codeVoice"},{"type":"text","text":", and expression parsing happens in "},{"code":"Expression.swift","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":1,"text":"Parsing Swift","anchor":"Parsing-Swift","type":"heading"},{"inlineContent":[{"type":"text","text":"Broadly, the parser has a one-to-one correspondence between syntax nodes"},{"type":"text","text":" "},{"type":"text","text":"and parsing functions. If a function consumes input from the token stream,"},{"type":"text","text":" "},{"type":"text","text":"it must be marked "},{"code":"mutating","type":"codeVoice"},{"type":"text","text":" to do so. Thus, parsing functions that only"},{"type":"text","text":" "},{"type":"text","text":"serve e.g. to read the current token and disambiguate the parse, or recover"},{"type":"text","text":" "},{"type":"text","text":"from a bad parse should be left "},{"code":"nonmutating","type":"codeVoice"},{"type":"text","text":" to indicate that they do not"},{"type":"text","text":" "},{"type":"text","text":"consume tokens."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Token consumption is generally either unconditional via "},{"code":"TokenConsumer.consumeAnyToken()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"or conditional via a combination of "},{"code":"TokenConsumer\/at(_:where:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"TokenConsumer.eat(_:)","type":"codeVoice"},{"type":"text","text":". When parsing conditionally, "},{"code":"at","type":"codeVoice"},{"type":"text","text":" returns a"},{"type":"text","text":" "},{"type":"text","text":"handle that is passed to "},{"code":"eat","type":"codeVoice"},{"type":"text","text":". This ensures that any structure that is"},{"type":"text","text":" "},{"type":"text","text":"checked for is actually parsed by the parser at that position. If the parser"},{"type":"text","text":" "},{"type":"text","text":"detects any unexpected structure, an assertion is raised. To perform"},{"type":"text","text":" "},{"type":"text","text":"conditional consumption and validation in one step, use "},{"code":"consume(if:)","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"one kind of token, or "},{"code":"consume(ifAny:)","type":"codeVoice"},{"type":"text","text":" to consume many kinds of tokens."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It can also be useful to expect the presence of certain structural elements."},{"type":"text","text":" "},{"type":"text","text":"For example, a function that parses the content of code items might expect"},{"type":"text","text":" "},{"type":"text","text":"an opening brace, its items, and also expect a closing brace:"}],"type":"paragraph"},{"code":["let lbrace = self.eat(.leftBrace)","\/*  *\/","let rbrace = self.expect(.rightBrace)"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"TokenConsumer.eat(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":"Parser.expect(_:remapping:)"},{"type":"text","text":" returns"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"missing"},{"type":"text","text":" token of the given kind. This allows the tree to remain"},{"type":"text","text":" "},{"type":"text","text":"well-formed even when the input text is not, all without affecting"},{"type":"text","text":" "},{"type":"text","text":"source fidelity."}],"type":"paragraph"},{"inlineContent":[{"text":"For compound syntactic structures, parsing loops are often required. The general","type":"text"},{"text":" ","type":"text"},{"text":"structure of a source-preserving loop is","type":"text"}],"type":"paragraph"},{"code":["var keepGoing: RawTokenSyntax? = nil","repeat {","  \/\/ Parse an element","  let element = self.parseElement()","","  \/\/ Consume the delimiter","  keepGoing = self.consume(if: .delimiter)","  elements.append(RawElementSyntax(element, ..., keepGoing))","} while keepGoing != nil"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Such parsing loops are kept enclosed in "},{"type":"codeVoice","code":"do"},{"type":"text","text":" blocks to avoid having their"},{"type":"text","text":" "},{"type":"text","text":"state leak into surrounding scopes."}],"type":"paragraph"},{"level":1,"text":"Lookahead","anchor":"Lookahead","type":"heading"},{"inlineContent":[{"text":"This parser provides at most one token worth of lookahead via","type":"text"},{"text":" ","type":"text"},{"code":"peek()","type":"codeVoice"},{"text":". If more tokens are required to disambiguate a parse, a","type":"text"},{"text":" ","type":"text"},{"code":"Parser.Lookahead","type":"codeVoice"},{"text":" instance should be constructed instead with","type":"text"},{"text":" ","type":"text"},{"code":"Parser.lookahead()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":1,"text":"Source Fidelity","anchor":"Source-Fidelity","type":"heading"},{"inlineContent":[{"type":"text","text":"The syntax trees produced by this parser are required to faithfully"},{"type":"text","text":" "},{"type":"text","text":"represent the input source text. As such, there are no utilities that allow"},{"type":"text","text":" "},{"type":"text","text":"for skipping tokens in the parser. In addition, consumed tokens must become"},{"type":"text","text":" "},{"type":"text","text":"part of at  least one syntax node."}],"type":"paragraph"},{"inlineContent":[{"text":"The exception to this is parser lookahead, which is allowed to skip as many","type":"text"},{"text":" ","type":"text"},{"text":"tokens as needed to disambiguate a parse. However, because lookahead","type":"text"},{"text":" ","type":"text"},{"text":"operates on a copy of the lexical stream, no input tokens are lost..","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.SwiftyLab.HelperCoders/documentation/SwiftParser/LookaheadRanges":{"abstract":[{"text":"Record the lookahead ranges for syntax nodes.","type":"text"}],"url":"\/documentation\/swiftparser\/lookaheadranges","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LookaheadRanges"}],"navigatorTitle":[{"kind":"identifier","text":"LookaheadRanges"}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftParser\/LookaheadRanges","title":"LookaheadRanges","role":"symbol","type":"topic"},"doc://com.SwiftyLab.HelperCoders/docum
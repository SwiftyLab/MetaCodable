aram","text":"encodable"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")"}],"abstract":[{"text":"Indicates whether super class conforms to ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" or not.","type":"text"}],"title":"Inherits(decodable:encodable:)","identifier":"doc:\/\/MetaCodable\/documentation\/MetaCodable\/Inherits(decodable:encodable:)","type":"topic","kind":"symbol","role":"symbol"},"https://github.com/apple/swift-evolution/blob/main/proposals/0407-member-macro-conformances.md":{"titleInlineContent":[{"type":"codeVoice","code":"Swift 5.9.2"}],"type":"link","title":"Swift 5.9.2","identifier":"https:\/\/github.com\/apple\/swift-evolution\/blob\/main\/proposals\/0407-member-macro-conformances.md","url":"https:\/\/github.com\/apple\/swift-evolution\/blob\/main\/proposals\/0407-member-macro-conformances.md"}}}
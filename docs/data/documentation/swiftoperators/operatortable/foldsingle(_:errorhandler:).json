{"abstract":[{"text":"“Fold” a sequence expression into a structured syntax tree.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"foldSingle"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"sequence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax012SequenceExprB0V","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/SequenceExprSyntax","text":"SequenceExprSyntax"},{"kind":"text","text":", "},{"kind":"externalParam","text":"errorHandler"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14SwiftOperators20OperatorErrorHandlera","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftOperators\/OperatorErrorHandler","text":"OperatorErrorHandler"},{"kind":"text","text":" = { throw $0 }) "},{"kind":"keyword","text":"rethrows"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax04ExprB0V","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/ExprSyntax","text":"ExprSyntax"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence expression results from parsing an expression involving"},{"type":"text","text":" "},{"type":"text","text":"infix operators, such as "},{"type":"codeVoice","code":"x + y * z"},{"type":"text","text":". Swift’s grammar does not"},{"type":"text","text":" "},{"type":"text","text":"involve operator precedence, so a sequence expression is a flat list"},{"type":"text","text":" "},{"type":"text","text":"of all of the terms "},{"type":"codeVoice","code":"x"},{"type":"text","text":", "},{"type":"codeVoice","code":"+"},{"
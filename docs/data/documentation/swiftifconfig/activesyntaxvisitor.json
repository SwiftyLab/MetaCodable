{"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxVisitor","interfaceLanguage":"swift"},"metadata":{"externalID":"s:13SwiftIfConfig19ActiveSyntaxVisitorC","roleHeading":"Class","symbolKind":"class","title":"ActiveSyntaxVisitor","navigatorTitle":[{"text":"ActiveSyntaxVisitor","kind":"identifier"}],"role":"symbol","modules":[{"name":"SwiftIfConfig"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActiveSyntaxVisitor","kind":"identifier"}]},"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxVisitor\/init(viewMode:configuration:)","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxVisitor\/init(viewMode:configuredRegions:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxVisitor\/diagnostics"],"anchor":"Instance-Properties","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftIfConfig\/ActiveSyntaxVisitor\/visit(_:)"],"anchor":"Instance-Methods","generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActiveSyntaxVisitor","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This subclass of "},{"type":"codeVoice","code":"SyntaxVisitor"},{"type":"text","text":" walks all of the syntax nodes in a given"},{"type":"text","text":" "},{"type":"text","text":"tree that are “active” according to a particular build configuration,"},{"type":"text","text":" "},{"type":"text","text":"meaning that the syntax would con
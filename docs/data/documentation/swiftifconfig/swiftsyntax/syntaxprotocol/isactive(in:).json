t"},{"text":"#elseif B","type":"text"},{"text":" ","type":"text"},{"text":"func g()","type":"text"},{"text":" ","type":"text"},{"text":"#elseif compiler(>= 12.0)","type":"text"},{"text":" ","type":"text"},{"text":"please print the number after 41","type":"text"},{"text":" ","type":"text"},{"text":"#endif","type":"text"},{"text":" ","type":"text"},{"text":"#endif","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"a call to "},{"type":"codeVoice","code":"isActive"},{"type":"text","text":" on the syntax node for the function "},{"type":"codeVoice","code":"g"},{"type":"text","text":" would return "},{"type":"codeVoice","code":"active"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"configuration options "},{"type":"codeVoice","code":"DEBUG"},{"type":"text","text":" and "},{"type":"codeVoice","code":"B"},{"type":"text","text":" are provided, but "},{"type":"codeVoice","code":"A"},{"type":"text","text":" is not."}]},{"type":"paragraph","inlineContent":[{"text":"If the compiler version is smaller than 12.0, then ","type":"text"},{"code":"isActive","type":"codeVoice"},{"text":" on any of the tokens within","type":"text"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"code":"#elseif","type":"codeVoice"},{"text":" block would return “unparsed”, because that syntax should not (conceptually)","type":"text"},{"text":" ","type":"text"},{"text":"be parsed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that this function requires processing all #ifs from the root node","type":"text"},{"text":" ","type":"text"},{"text":"of the syntax tree down to the current node. If performing more than a","type":"text"},{"text":" ","type":"text"},{"text":"small number of ","type":"text"},{"code":"isActive(_:)","type":"codeVoice"},{"text":" queries, please form a ","type":"text"},{"code":"ConfiguredRegions","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instance and use ","type":"text"},{"c
eif B","type":"text"},{"text":" ","type":"text"},{"text":"func g()","type":"text"},{"text":" ","type":"text"},{"text":"#elseif compiler(>= 12.0)","type":"text"},{"text":" ","type":"text"},{"text":"please print the number after 41","type":"text"},{"text":" ","type":"text"},{"text":"#endif","type":"text"},{"text":" ","type":"text"},{"text":"#endif","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"a call to ","type":"text"},{"type":"codeVoice","code":"isActive"},{"text":" on the syntax node for the function ","type":"text"},{"type":"codeVoice","code":"g"},{"text":" would return ","type":"text"},{"type":"codeVoice","code":"active"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"configuration options ","type":"text"},{"type":"codeVoice","code":"DEBUG"},{"text":" and ","type":"text"},{"code":"B","type":"codeVoice"},{"text":" are provided, but ","type":"text"},{"code":"A","type":"codeVoice"},{"text":" is not.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the compiler version is smaller than 12.0, then ","type":"text"},{"code":"isActive","type":"codeVoice"},{"text":" on any of the tokens within","type":"text"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"code":"#elseif","type":"codeVoice"},{"text":" block would return “unparsed”, because that syntax should not (conceptually)","type":"text"},{"text":" ","type":"text"},{"text":"be parsed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this function requires processing all #ifs from the root node"},{"type":"text","text":" "},{"type":"text","text":"of the syntax tree down to the current node. If performing more than a"},{"type":"text","text":" "},{"type":"text","text":"small number of "},{"type":"codeVoice","code":"isActive(_:)"},{"type":"text","text":" queries, please form a "},{"type":"codeVoice","code":"ConfiguredRegions"},{"type":"text","text":" "},{"type":"text","text":"instance and use "},{"type":"codeVoice",
,{"inlineContent":[{"type":"text","text":"Trivia is always attached to tokens, not to layout nodes. This will return the trailing trivia of the last token"},{"type":"text","text":" "},{"type":"text","text":"within the subtree. If no such token exists, this returns empty trivia."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/Trivia"},{"type":"text","text":" is not able to represent invalid UTF-8 sequences. To get"},{"type":"text","text":" "},{"type":"text","text":"the leading trivia text including all invalid UTF-8 sequences, use"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["node.syntaxTextBytes[(node.byteSize - node.trailingTriviaLength.utf8Length)...]"]}],"kind":"content"}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/GenericRequirementSyntax":{"kind":"symbol","type":"topic","navigatorTitle":[{"text":"GenericRequirementSyntax","kind":"identifier"}],"url":"\/documentation\/swiftsyntax\/genericrequirementsyntax","abstract":[],"title":"GenericRequirementSyntax","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GenericRequirementSyntax","kind":"identifier"}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/GenericRequirementSyntax","role":"symbol"},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/Trivia":{"abstract":[{"type":"text","text":"Trivia represent pieces of the source code that are not relevant to represent"},{"type":"text","text":" "},{"type":"text","text":"its semantic structure."}],"title":"Trivia","type":"topic","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/Trivia","navigatorTitle":[{"text":"Trivia","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Trivia","kind":"identifier"}],"role":"symbol","kind":"symbol",
esents a tree of nodes with tokens at the leaves."},{"type":"text","text":" "},{"type":"text","text":"Each node has accessors for its known children, and allows efficient"},{"type":"text","text":" "},{"type":"text","text":"iteration over the children through its "},{"type":"codeVoice","code":"children"},{"type":"text","text":" property."}]},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/Syntax/trailingTrivia":{"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/Syntax\/trailingTrivia","abstract":[{"type":"text","text":"The trailing trivia of this syntax node."}],"url":"\/documentation\/swiftsyntax\/syntax\/trailingtrivia","type":"topic","kind":"symbol","role":"symbol","title":"trailingTrivia","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"trailingTrivia"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Trivia","preciseIdentifier":"s:11SwiftSyntax6TriviaV"}]}}}
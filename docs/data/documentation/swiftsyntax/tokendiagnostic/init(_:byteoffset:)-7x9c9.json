{"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/TokenDiagnostic"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/TokenDiagnostic\/init(_:byteOffset:)-7x9c9"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","variants":[{"paths":["\/documentation\/swiftsyntax\/tokendiagnostic\/init(_:byteoffset:)-7x9c9"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"kind","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/TokenDiagnostic\/Kind-swift.enum","text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:11SwiftSyntax15TokenDiagnosticV4KindO"},{"text":", ","kind":"text"},{"text":"byteOffset","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":")","kind":"text"}]}]},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since the offset within the token is represented by 16 bits only,"},{"type":"text","text":" "},{"type":"text","text":"diagnostics that are more than 2^16 bytes from the token’s start cannot"},{"type":"text","text":" "},{"type":"text","text":"be represented. In that case, emit a "},{"type":"codeVoice","code":"tokenDiagnosticOffsetOverflow"},{"type":"text","text":" "},{"type":"text","text":"diagnostic at the token’s start. 2^16 is quite a lot of characters for"},{"type":"text","text":" "},{"type":"text","text":"a single token (even when we include comments as trivia), so we don’t"},{"type":"text","text":" "},{"type":"text","text":"expect to hit this case most of the time."}]}]}],"metadata":{"modules":[{"name":"SwiftSyntax"}],"roleHeading":"Initializer","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Kind","preciseIdentifier":"s:11SwiftSyntax15TokenDiagnosticV4KindO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"byteOffset"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"externalID":"s:11SwiftSyntax15TokenDiagnosticV_10byteOffsetA2C4KindO_Sitcfc","symbolKind":"init","title":"init(_:byteOffset:)","role":"symbol"},"sections":[],"abstract":[{"type":"text","text":"Construct a diagnostic of the given "},{"type":"codeVoice","code":"kind"},{"type":"text","text":" that is anchored at "},{"type":"codeVoice","code":"byteOffset"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"measured in UTF-8 bytes relative to the leading trivia start of the token"},{"type":"text","text":" "},{"type":"text","text":"this diagnostic will be attached to."}],"references":{"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/TokenDiagnostic":{"abstract":[{"type":"text","text":"If the token has an error that’s inherent to the token itself and not its"},{"type":"text","text":" "},{"type":"text","text":"surrounding structure, this defines the type of the error."},{"type":"text","text":" "},{"code":"byteOffset","type":"codeVoice"},{"type":"text","text":" specifies at which offset the error occurred."}],"title":"TokenDiagnostic","type":"topic","url":"\/documentation\/swiftsyntax\/tokendiagnostic","navigatorTitle":[{"text":"TokenDiagnostic","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TokenDiagnostic","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/TokenDiagnostic
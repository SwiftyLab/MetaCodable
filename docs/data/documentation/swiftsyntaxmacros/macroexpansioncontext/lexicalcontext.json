{"identifier":{"url":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros\/MacroExpansionContext\/lexicalContext","interfaceLanguage":"swift"},"defaultImplementationsSections":[{"title":"MacroExpansionContext Implementations","anchor":"MacroExpansionContext-Implementations","identifiers":["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros\/MacroExpansionContext\/lexicalContext-478jr"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicalContext"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/Syntax","text":"Syntax","preciseIdentifier":"s:11SwiftSyntax0B0V"},{"kind":"text","text":"] { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" }"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lexical contexts will have many of their details stripped out to prevent"},{"type":"text","text":" "},{"type":"text","text":"macros from having visibility into unrelated code. For example, functions"},{"type":"text","text":" "},{"type":"text","text":"and closures have their bodies removed, types and extensions have their"},{"type":"text","text":" "},{"type":"text","text":"member lists emptied, and properties and subscripts have their accessor"},{"type":"text","text":" "},{"type":"text","text":"blocks removed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The first entry in the array is the innermost context. For attached"},{"type":"text","text":" "},{"type":"text","text":"macros, this is often the declaration to which the macro is attached."},{"type":"text","text":" "},{"type":"text","text":"This array can be empty if there is no context, for example when a"},{"type":"text","text":" "},{"type":"text","text":"freestanding macro is used at file scope."}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftsyntaxmacros\/macroexpansioncontext\/lexicalcontext"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Return an array of enclosing lexical contexts for the purpose of macros,","type":"text"},{"text":" ","type":"text"},{"text":"starting from the syntax node at which the macro expansion occurs","type":"text"},{"text":" ","type":"text"},{"text":"and containing all “context” nodes including functions, closures, types,","type":"text"},{"text":" ","type":"text"},{"text":"properties, subscripts, and extensions.","type":"text"}],"metadata":{"externalID":"s:17SwiftSyntaxMacros21MacroExpansionContextP07lexicalF0Say0aB00B0VGvp","required":true,"symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicalContext","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Syntax","preciseIdentifier":"s:11SwiftSyntax0B0V","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"roleHeading":"Instance Property","role":"symbol","modules":[{"name":"SwiftSyntaxMacros"}],"title":"lexicalContext"},"hierarchy":{"paths":[["doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros","doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros\/MacroExpansionContext"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntaxMacros/MacroExpansionContext/lexicalContext-478jr":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"lexicalContext"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:11SwiftSyntax0B0V","kind":"typeIdentifier","text":"Syntax"},{"kind":"text","text":"]"}],"abstract":[],"deprecated":true,"title":"lexicalContext","type":"topic","url":"\/documentation\/swiftsyntaxmacros\/macroexpansioncontext\/lexicalcontext-478jr","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros\/MacroExpansionContext\/lexicalContext-478jr","role":"symbol","kind":"symbol"},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntaxMacros":{"kind":"symbol","url":"\/documentation\/swiftsyntaxmacros","type":"topic","abstract":[],"title":"SwiftSyntaxMacros","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros","role":"collection"},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntaxMacros/MacroExpansionContext":{"title":"MacroExpansionContext","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MacroExpansionContext","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/swiftsyntaxmacros\/macroexpansioncontext","navigatorTitle":[{"text":"MacroExpansionContext","kind":"identifier"}],"abstract":[{"text":"Interface to extract information about the context in which a given","type":"text"},{"text":" ","type":"text"},{"text":"macro is expanded.","type":"text"}],"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros\/MacroExpansionContext"},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntaxMacros/MacroExpansionContext/lexicalContext":{"defaultImplementations":1,"type":"topic","role":"symbol","url":"\/documentation\/swiftsyntaxmacros\/macroexpansioncontext\/lexicalcontext","title":"lexicalContext","kind":"symbol","required":true,"identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntaxMacros\/MacroExpansionContext\/lexicalContext","abstract":[{"text":"Return an array of enclosing lexical contexts for the purpose of macros,","type":"text"},{"text":" ","type":"text"},{"text":"starting from the syntax node at which the macro expansion occurs","type":"text"},{"text":" ","type":"text"},{"text":"and containing all “context” nodes including functions, closures, types,","type":"text"},{"text":" ","type":"text"},{"text":"properties, subscripts, and extensions.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"lexicalContext","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:11SwiftSyntax0B0V","text":"Syntax","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://com.SwiftyLab.HelperCoders/documentation/SwiftSyntax/Syntax":{"kind":"symbol","url":"\/documentation\/swiftsyntax\/syntax","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Syntax"}],"role":"symbol","type":"topic","title":"Syntax","identifier":"doc:\/\/com.SwiftyLab.HelperCoders\/documentation\/SwiftSyntax\/Syntax","navigatorTitle":[{"kind":"identifier","text":"Syntax"}],"abstract":[{"type":"text","text":"A Syntax node represents a tree of nodes with tokens at the leaves."},{"type":"text","text":" "},{"type":"text","text":"Each node has accessors for its known children, and allows efficient"},{"type":"text","text":" "},{"type":"text","text":"iteration over the children through its "},{"type":"codeVoice","code":"children"},{"type":"text","text":" property."}]}}}